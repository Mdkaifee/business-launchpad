# Copy these names into Render → your backend service → Environment.
# Paste the real values there — never commit them.

# The Gmail account that SENDS the notifications. Use a dedicated account
# (e.g. a new forms@ Gmail), NOT aliaabdullah1211@gmail.com — if the sender is
# the inbox owner, Gmail labels every notification "me".
# The refresh token must be issued while signed in to THIS account.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Shown in the email footer.
SUPPORT_EMAIL=info@aliyaabdullah.com

# The receiving inbox is fixed in code (aliaabdullah1211@gmail.com).
# NOTIFY_TO_EMAIL is ignored — delete it from Render.

# Optional SMTP (Hostinger etc.). Leave ALL THREE empty on Render's free plan:
# it blocks outbound SMTP ports 25/465/587. Used only when all three are set.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
